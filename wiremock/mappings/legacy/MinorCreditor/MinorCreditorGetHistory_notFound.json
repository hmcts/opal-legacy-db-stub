{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/opal",
    "queryParameters": {
      "actionType": {
        "equalTo": "LIBRA.get_minor_creditor_account_history"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.creditor_account_id",
          "equalTo": "99999999999999"
        }
      }
    ]
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/xml"
    },
    "body": "<error><message>Minor creditor account history not found</message></error>"
  }
}
